#: ../libpq-oauth/oauth-curl.c:439 ../libpq-oauth/oauth-curl.c:450
#, c-format
msgid "could not set libcurl option \"%s\" on OAuth connection: %s"
msgstr "ne povis agordi opcion \"%s\" de libcurl por OAuth-konekto: %s"

#: ../libpq-oauth/oauth-curl.c:461
#, c-format
msgid "could not get libcurl info \"%s\" from OAuth response: %s"
msgstr "ne povis akiri informon \"%s\" de libcurl el OAuth-respondo: %s"

#: ../libpq-oauth/oauth-curl.c:530 fe-auth-oauth.c:216 fe-auth-oauth.c:278
#: fe-auth-oauth.c:340
#, c-format
msgid "field \"%s\" must be a string"
msgstr "kampo \"%s\" devas esti ĉeno"

#: ../libpq-oauth/oauth-curl.c:534
#, c-format
msgid "field \"%s\" must be a number"
msgstr "kampo \"%s\" devas esti nombro"

#: ../libpq-oauth/oauth-curl.c:538
#, c-format
msgid "field \"%s\" must be an array of strings"
msgstr "kampo \"%s\" devas esti aro de ĉenoj"

#: ../libpq-oauth/oauth-curl.c:543
#, c-format
msgid "field \"%s\" has unexpected type"
msgstr "kampo \"%s\" havas neatenditan tipon"

#: ../libpq-oauth/oauth-curl.c:567 ../libpq-oauth/oauth-curl.c:677
#: fe-auth-oauth.c:222 fe-auth-oauth.c:284
#, c-format
msgid "JSON is too deeply nested"
msgstr "JSON estas tro profunde nestita"

#: ../libpq-oauth/oauth-curl.c:619 fe-auth-oauth.c:331
#, c-format
msgid "field \"%s\" is duplicated"
msgstr "kampo \"%s\" estas duobligita"

#: ../libpq-oauth/oauth-curl.c:659 ../libpq-oauth/oauth-curl.c:719
#: fe-auth-oauth.c:271 fe-auth-oauth.c:305
#, c-format
msgid "top-level element must be an object"
msgstr "ĉefnivela elemento devas esti objekto"

#: ../libpq-oauth/oauth-curl.c:822
#, c-format
msgid "no content type was provided"
msgstr "neniu tipo de enhavo estis donita"

#: ../libpq-oauth/oauth-curl.c:861
#, c-format
msgid "unexpected content type: \"%s\""
msgstr "neatendita tipo de enhavo: \"%s\""

#: ../libpq-oauth/oauth-curl.c:886
#, c-format
msgid "response contains embedded null"
msgstr "respondo enhavas enigitan nulon"

#: ../libpq-oauth/oauth-curl.c:896
#, c-format
msgid "response is not valid UTF-8"
msgstr "respondo ne estas valida UTF-8"

#: ../libpq-oauth/oauth-curl.c:936
#, c-format
msgid "field \"%s\" is missing"
msgstr "kampo \"%s\" mankas"

#: ../libpq-oauth/oauth-curl.c:1142
msgid "could not parse token error response"
msgstr "ne povis analizi eraran respondon de ĵetono"

#: ../libpq-oauth/oauth-curl.c:1170
#, c-format
msgid "provider rejected the oauth_client_secret"
msgstr "provizanto malakceptis la oauth_client_secret"

#: ../libpq-oauth/oauth-curl.c:1171
#, c-format
msgid ""
"provider requires client authentication, and no oauth_client_secret is set"
msgstr ""
"provizanto postulas aŭtentigon de kliento, kaj neniu oauth_client_secret "
"estas agordita"

#: ../libpq-oauth/oauth-curl.c:1604
#, c-format
msgid "could not check timer expiration: %m"
msgstr "ne povis kontroli finiĝon de tempomezurilo: %m"

#: ../libpq-oauth/oauth-curl.c:1766
#, c-format
msgid "could not create libcurl multi handle"
msgstr "ne povis krei pluran traktilon de libcurl"

#: ../libpq-oauth/oauth-curl.c:1786
#, c-format
msgid "could not create libcurl handle"
msgstr "ne povis krei traktilon de libcurl"

#: ../libpq-oauth/oauth-curl.c:1886
#, c-format
msgid "response is too large"
msgstr "respondo estas tro granda"

#: ../libpq-oauth/oauth-curl.c:1928
#, c-format
msgid "could not queue HTTP request: %s"
msgstr "ne povis envicigi HTTP-peton: %s"

#: ../libpq-oauth/oauth-curl.c:1945 ../libpq-oauth/oauth-curl.c:2003
#, c-format
msgid "asynchronous HTTP request failed: %s"
msgstr "nesinkrona HTTP-peto malsukcesis: %s"

#: ../libpq-oauth/oauth-curl.c:2044
#, c-format
msgid "libcurl easy handle removal failed: %s"
msgstr "forigo de simpla traktilo de libcurl malsukcesis: %s"

#: ../libpq-oauth/oauth-curl.c:2055
#, c-format
msgid "no result was retrieved for the finished handle"
msgstr "neniu rezulto estis ricevita por la finita traktilo"

#: ../libpq-oauth/oauth-curl.c:2188 ../libpq-oauth/oauth-curl.c:2493
#: ../libpq-oauth/oauth-curl.c:2571
#, c-format
msgid "unexpected response code %ld"
msgstr "neatendita responda kodo %ld"

#: ../libpq-oauth/oauth-curl.c:2195
msgid "could not parse OpenID discovery document"
msgstr "ne povis analizi eltrovan dokumenton de OpenID"

#: ../libpq-oauth/oauth-curl.c:2260
#, c-format
msgid "issuer identifier (%s) does not match oauth_issuer (%s)"
msgstr "identigilo de eldonanto (%s) ne kongruas kun oauth_issuer (%s)"

#: ../libpq-oauth/oauth-curl.c:2287
#, c-format
msgid "issuer \"%s\" does not provide a device authorization endpoint"
msgstr "eldonanto \"%s\" ne provizas finpunkton por aparata rajtigo"

#: ../libpq-oauth/oauth-curl.c:2313
#, c-format
msgid "device authorization endpoint \"%s\" must use HTTPS"
msgstr "finpunkto por aparata rajtigo \"%s\" devas uzi HTTPS"

#: ../libpq-oauth/oauth-curl.c:2322
#, c-format
msgid "token endpoint \"%s\" must use HTTPS"
msgstr "ĵetona finpunkto \"%s\" devas uzi HTTPS"

#: ../libpq-oauth/oauth-curl.c:2462
msgid "could not parse device authorization"
msgstr "ne povis analizi aparatan rajtigon"

#: ../libpq-oauth/oauth-curl.c:2549
msgid "could not parse access token response"
msgstr "ne povis analizi respondon de alira ĵetono"

#: ../libpq-oauth/oauth-curl.c:2626
#, c-format
msgid "slow_down interval overflow"
msgstr "superfluo de la intervalo slow_down"

#. translator: The first %s is a URL for the user to visit in a
#. browser, and the second %s is a code to be copy-pasted there.
#: ../libpq-oauth/oauth-curl.c:2662
#, c-format
msgid "Visit %s and enter the code: %s\n"
msgstr "Vizitu %s kaj enigu la kodon: %s\n"

#: ../libpq-oauth/oauth-curl.c:2667
#, c-format
msgid "device prompt failed"
msgstr "invito de aparato malsukcesis"

#: ../libpq-oauth/oauth-curl.c:2720
msgid "curl_global_init previously failed during OAuth setup"
msgstr "curl_global_init antaŭe malsukcesis dum agordo de OAuth"

#: ../libpq-oauth/oauth-curl.c:2738
msgid "curl_global_init failed during OAuth setup"
msgstr "curl_global_init malsukcesis dum agordo de OAuth"

#: ../libpq-oauth/oauth-curl.c:2760
msgid ""
"libcurl is no longer thread-safe\n"
"\tCurl initialization was reported thread-safe when libpq\n"
"\twas compiled, but the currently installed version of\n"
"\tlibcurl reports that it is not. Recompile libpq against\n"
"\tthe installed version of libcurl."
msgstr ""
"libcurl ne plu estas fadenosekura\n"
"\tLa ekigo de Curl estis raportita kiel fadenosekura kiam libpq\n"
"\testis kompilita, sed la nuntempe instalita versio de\n"
"\tlibcurl raportas ke ĝi ne estas tia. Rekompilu libpq kontraŭ\n"
"\tla instalita versio de libcurl."

#: ../libpq-oauth/oauth-curl.c:2900
msgid "could not fetch OpenID discovery document"
msgstr "ne povis ricevi eltrovan dokumenton de OpenID"

#: ../libpq-oauth/oauth-curl.c:2914
msgid "cannot run OAuth device authorization"
msgstr "ne povas ruli aparatan rajtigon de OAuth"

#: ../libpq-oauth/oauth-curl.c:2918
msgid "could not obtain device authorization"
msgstr "ne povis akiri aparatan rajtigon"

#: ../libpq-oauth/oauth-curl.c:2929 ../libpq-oauth/oauth-curl.c:2997
msgid "could not obtain access token"
msgstr "ne povis akiri aliran ĵetonon"

#: fe-auth-oauth.c:140
#, c-format
msgid "internal error: no OAuth token was set for the connection"
msgstr "interna eraro: neniu OAuth-ĵetono estis agordita por la konekto"

#: fe-auth-oauth.c:403
#, c-format
msgid "OAuth discovery URI \"%s\" must use HTTPS"
msgstr "eltrova URI \"%s\" de OAuth devas uzi HTTPS"

#: fe-auth-oauth.c:420
#, c-format
msgid "OAuth discovery URI \"%s\" must not contain query or fragment components"
msgstr ""
"eltrova URI \"%s\" de OAuth ne rajtas enhavi komponantojn de informpeto aŭ "
"fragmento"

#: fe-auth-oauth.c:435
#, c-format
msgid "OAuth discovery URI \"%s\" is not a .well-known URI"
msgstr "eltrova URI \"%s\" de OAuth ne estas .well-known URI"

#: fe-auth-oauth.c:461
#, c-format
msgid "OAuth discovery URI \"%s\" uses an unsupported .well-known suffix"
msgstr "eltrova URI \"%s\" de OAuth uzas nesubtenatan .well-known-finaĵon"

#: fe-auth-oauth.c:486
#, c-format
msgid "OAuth discovery URI \"%s\" uses an invalid format"
msgstr "eltrova URI \"%s\" de OAuth uzas nevalidan formaton"

#: fe-auth-oauth.c:535
#, c-format
msgid "server's error message contained an embedded NULL, and was discarded"
msgstr ""
"la erara mesaĝo de la servilo enhavis enigitan NULL-on, kaj estis forĵetita"

#: fe-auth-oauth.c:546
#, c-format
msgid "server's error response is not valid UTF-8"
msgstr "la erara respondo de la servilo ne estas valida UTF-8"

#: fe-auth-oauth.c:586
#, c-format
msgid "failed to parse server's error response: %s"
msgstr "analizo de la erara respondo de la servilo malsukcesis: %s"

#: fe-auth-oauth.c:617
#, c-format
msgid ""
"server's discovery document at %s (issuer \"%s\") is incompatible with "
"oauth_issuer (%s)"
msgstr ""
"la eltrova dokumento de la servilo ĉe %s (eldonanto \"%s\") ne kongruas kun "
"oauth_issuer (%s)"

#: fe-auth-oauth.c:638
#, c-format
msgid "server's discovery document has moved to %s (previous location was %s)"
msgstr ""
"la eltrova dokumento de la servilo moviĝis al %s (antaŭa loko estis %s)"

#: fe-auth-oauth.c:659
#, c-format
msgid "server sent error response without a status"
msgstr "la servilo sendis eraran respondon sen stato"

#: fe-auth-oauth.c:670
#, c-format
msgid "server rejected OAuth bearer token: %s"
msgstr "la servilo malakceptis portantan ĵetonon de OAuth: %s"

#: fe-auth-oauth.c:717
msgid "user-defined OAuth flow failed"
msgstr "uzant-difinita OAuth-fluo malsukcesis"

#: fe-auth-oauth.c:747
#, c-format
msgid "user-defined OAuth flow provided neither a token nor an async callback"
msgstr ""
"uzant-difinita OAuth-fluo donis nek ĵetonon nek nesinkronan revokfunkcion"

#: fe-auth-oauth.c:769
#, c-format
msgid "user-defined OAuth flow did not provide a token"
msgstr "uzant-difinita OAuth-fluo ne donis ĵetonon"

#: fe-auth-oauth.c:788
#, c-format
msgid "user-defined OAuth flow did not provide a socket for polling"
msgstr "uzant-difinita OAuth-fluo ne donis soketon por sondado"

#: fe-auth-oauth.c:932
msgid "could not find entry point for libpq-oauth"
msgstr "ne povis trovi enirpunkton por libpq-oauth"

#: fe-auth-oauth.c:1097
#, c-format
msgid "no OAuth flows are available (try installing the libpq-oauth package)"
msgstr "neniuj OAuth-fluoj disponeblas (provu instali la pakon libpq-oauth)"

#: fe-auth-oauth.c:1141
#, c-format
msgid ""
"server requires OAuth authentication, but oauth_issuer and oauth_client_id "
"are not both set"
msgstr ""
"la servilo postulas OAuth-aŭtentigon, sed oauth_issuer kaj oauth_client_id ne"
" estas ambaŭ agorditaj"

#: fe-auth-oauth.c:1301
#, c-format
msgid "server sent unexpected additional OAuth data"
msgstr "la servilo sendis neatenditajn pluajn OAuth-datumojn"

#: fe-auth-oauth.c:1341
#, c-format
msgid ""
"server requires OAuth authentication, but no discovery metadata was provided"
msgstr ""
"la servilo postulas OAuth-aŭtentigon, sed neniuj eltrovaj metadatumoj estis "
"donitaj"

#: fe-auth-oauth.c:1379
#, c-format
msgid "internal error: OAuth flow did not set a token"
msgstr "interna eraro: OAuth-fluo ne agordis ĵetonon"

#: fe-auth-oauth.c:1397
#, c-format
msgid "server sent additional OAuth data after error"
msgstr "la servilo sendis pluajn OAuth-datumojn post eraro"

#: fe-auth-oauth.c:1401
#, c-format
msgid "invalid OAuth exchange state"
msgstr "nevalida stato de OAuth-interŝanĝo"

#: fe-auth-oauth.c:1414
#, c-format
msgid "retrying connection with new bearer token"
msgstr "reprovas konekton kun nova portanta ĵetono"

#: fe-auth-scram.c:228
#, c-format
msgid "malformed SCRAM message (empty message)"
msgstr "misformita SCRAM-mesaĝo (malplena mesaĝo)"

#: fe-auth-scram.c:233
#, c-format
msgid "malformed SCRAM message (length mismatch)"
msgstr "misformita SCRAM-mesaĝo (malkongrua longo)"

#: fe-auth-scram.c:277
#, c-format
msgid "could not verify server signature: %s"
msgstr "ne povis kontroli subskribon de la servilo: %s"

#: fe-auth-scram.c:283
#, c-format
msgid "incorrect server signature"
msgstr "malĝusta subskribo de la servilo"

#: fe-auth-scram.c:292
#, c-format
msgid "invalid SCRAM exchange state"
msgstr "nevalida stato de SCRAM-interŝanĝo"

#: fe-auth-scram.c:316
#, c-format
msgid "malformed SCRAM message (attribute \"%c\" expected)"
msgstr "misformita SCRAM-mesaĝo (atributo \"%c\" atendita)"

#: fe-auth-scram.c:325
#, c-format
msgid "malformed SCRAM message (expected character \"=\" for attribute \"%c\")"
msgstr "misformita SCRAM-mesaĝo (atendita signo \"=\" por atributo \"%c\")"

#: fe-auth-scram.c:365
#, c-format
msgid "could not generate nonce"
msgstr "ne povis generi noncon"

#: fe-auth-scram.c:381
#, c-format
msgid "could not encode nonce"
msgstr "ne povis kodi noncon"

#: fe-auth-scram.c:569
#, c-format
msgid "could not calculate client proof: %s"
msgstr "ne povis kalkuli klientan pruvon: %s"

#: fe-auth-scram.c:584
#, c-format
msgid "could not encode client proof"
msgstr "ne povis kodi klientan pruvon"

#: fe-auth-scram.c:636
#, c-format
msgid "invalid SCRAM response (nonce mismatch)"
msgstr "nevalida SCRAM-respondo (malkongrua nonco)"

#: fe-auth-scram.c:666
#, c-format
msgid "malformed SCRAM message (invalid salt)"
msgstr "misformita SCRAM-mesaĝo (nevalida salo)"

#: fe-auth-scram.c:679
#, c-format
msgid "malformed SCRAM message (invalid iteration count)"
msgstr "misformita SCRAM-mesaĝo (nevalida ripetnombro)"

#: fe-auth-scram.c:684
#, c-format
msgid "malformed SCRAM message (garbage at end of server-first-message)"
msgstr "misformita SCRAM-mesaĝo (rubo ĉe la fino de server-first-message)"

#: fe-auth-scram.c:718
#, c-format
msgid "error received from server in SCRAM exchange: %s"
msgstr "eraro ricevita de la servilo en SCRAM-interŝanĝo: %s"

#: fe-auth-scram.c:733
#, c-format
msgid "malformed SCRAM message (garbage at end of server-final-message)"
msgstr "misformita SCRAM-mesaĝo (rubo ĉe la fino de server-final-message)"

#: fe-auth-scram.c:750
#, c-format
msgid "malformed SCRAM message (invalid server signature)"
msgstr "misformita SCRAM-mesaĝo (nevalida subskribo de la servilo)"

#: fe-auth-scram.c:940
msgid "could not generate random salt"
msgstr "ne povis generi hazardan salon"

#: fe-auth.c:80
#, c-format
msgid "out of memory allocating GSSAPI buffer (%d)"
msgstr "memoro elĉerpiĝis dum asignado de GSSAPI-bufro (%d)"

#: fe-auth.c:146
msgid "GSSAPI continuation error"
msgstr "eraro de daŭrigo de GSSAPI"

#: fe-auth.c:176 fe-auth.c:410 fe-gssapi-common.c:97 fe-secure-common.c:99
#: fe-secure-common.c:173
#, c-format
msgid "host name must be specified"
msgstr "nomo de gastiganto devas esti specifita"

#: fe-auth.c:182
#, c-format
msgid "duplicate GSS authentication request"
msgstr "duobla peto de GSS-aŭtentigo"

#: fe-auth.c:246
#, c-format
msgid "out of memory allocating SSPI buffer (%d)"
msgstr "memoro elĉerpiĝis dum asignado de SSPI-bufro (%d)"

#: fe-auth.c:297
msgid "SSPI continuation error"
msgstr "eraro de daŭrigo de SSPI"

#: fe-auth.c:372
#, c-format
msgid "duplicate SSPI authentication request"
msgstr "duobla peto de SSPI-aŭtentigo"

#: fe-auth.c:397
msgid "could not acquire SSPI credentials"
msgstr "ne povis akiri akreditaĵojn de SSPI"

#: fe-auth.c:449
#, c-format
msgid "channel binding required, but SSL not in use"
msgstr "kanala ligado postulata, sed SSL ne estas uzata"

#: fe-auth.c:455
#, c-format
msgid "duplicate SASL authentication request"
msgstr "duobla peto de SASL-aŭtentigo"

#: fe-auth.c:513
#, c-format
msgid "channel binding is required, but client does not support it"
msgstr "kanala ligado estas postulata, sed la kliento ne subtenas ĝin"

#: fe-auth.c:529
#, c-format
msgid ""
"server offered SCRAM-SHA-256-PLUS authentication over a non-SSL connection"
msgstr "la servilo proponis SCRAM-SHA-256-PLUS-aŭtentigon per ne-SSL-konekto"

#: fe-auth.c:551
#, c-format
msgid "none of the server's SASL authentication mechanisms are supported"
msgstr "neniu el la SASL-aŭtentigaj mekanismoj de la servilo estas subtenata"

#: fe-auth.c:571
#, c-format
msgid ""
"authentication method requirement \"%s\" failed: server requested %s "
"authentication"
msgstr ""
"postulo pri aŭtentiga metodo \"%s\" malsukcesis: la servilo petis "
"%s-aŭtentigon"

#: fe-auth.c:580
#, c-format
msgid ""
"channel binding is required, but server did not offer an authentication "
"method that supports channel binding"
msgstr ""
"kanala ligado estas postulata, sed la servilo ne proponis aŭtentigan metodon "
"kiu subtenas kanalan ligadon"

#: fe-auth.c:716
#, c-format
msgid "out of memory allocating SASL buffer (%d)"
msgstr "memoro elĉerpiĝis dum asignado de SASL-bufro (%d)"

#: fe-auth.c:758
#, c-format
msgid ""
"AuthenticationSASLFinal received from server, but SASL authentication was not"
" completed"
msgstr ""
"AuthenticationSASLFinal ricevita de la servilo, sed SASL-aŭtentigo ne estis "
"kompletigita"

#: fe-auth.c:768
#, c-format
msgid "no client response found after SASL exchange success"
msgstr "neniu kliento-respondo trovita post sukceso de SASL-interŝanĝo"

#: fe-auth.c:836 fe-auth.c:843 fe-auth.c:1476 fe-auth.c:1487
#, c-format
msgid "could not encrypt password: %s"
msgstr "ne povis ĉifri pasvorton: %s"

#: fe-auth.c:873
msgid "server requested a cleartext password"
msgstr "la servilo petis klartekstan pasvorton"

