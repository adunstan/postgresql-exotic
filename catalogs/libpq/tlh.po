#: ../libpq-oauth/oauth-curl.c:530 fe-auth-oauth.c:216 fe-auth-oauth.c:278
#: fe-auth-oauth.c:340
#, c-format
msgid "field \"%s\" must be a string"
msgstr "yotlh \"%s\" ngutlh tlhegh 'oHnIS"

#: ../libpq-oauth/oauth-curl.c:534
#, c-format
msgid "field \"%s\" must be a number"
msgstr "yotlh \"%s\" mI' 'oHnIS"

#: ../libpq-oauth/oauth-curl.c:538
#, c-format
msgid "field \"%s\" must be an array of strings"
msgstr "yotlh \"%s\" ngutlh tlhegh mI' tetlh 'oHnIS"

#: ../libpq-oauth/oauth-curl.c:543
#, c-format
msgid "field \"%s\" has unexpected type"
msgstr "yotlh \"%s\" Segh pIHbe'bogh ghajlu'"

#: ../libpq-oauth/oauth-curl.c:567 ../libpq-oauth/oauth-curl.c:677
#: fe-auth-oauth.c:222 fe-auth-oauth.c:284
#, c-format
msgid "JSON is too deeply nested"
msgstr "JSON tlhoy 'elqa'lu'"

#: ../libpq-oauth/oauth-curl.c:619 fe-auth-oauth.c:331
#, c-format
msgid "field \"%s\" is duplicated"
msgstr "yotlh \"%s\" cha'lu'"

#: ../libpq-oauth/oauth-curl.c:659 ../libpq-oauth/oauth-curl.c:719
#: fe-auth-oauth.c:271 fe-auth-oauth.c:305
#, c-format
msgid "top-level element must be an object"
msgstr "Dung patlh Doch boS 'oHnIS"

#: ../libpq-oauth/oauth-curl.c:822
#, c-format
msgid "no content type was provided"
msgstr "De' Segh noblu'pu'be'"

#: ../libpq-oauth/oauth-curl.c:861
#, c-format
msgid "unexpected content type: \"%s\""
msgstr "De' Segh pIHbe'bogh: \"%s\""

#: ../libpq-oauth/oauth-curl.c:886
#, c-format
msgid "response contains embedded null"
msgstr "jangghach pagh qengbogh ngaS"

#: ../libpq-oauth/oauth-curl.c:896
#, c-format
msgid "response is not valid UTF-8"
msgstr "jangghach UTF-8 lughbe'"

#: ../libpq-oauth/oauth-curl.c:936
#, c-format
msgid "field \"%s\" is missing"
msgstr "yotlh \"%s\" Hutlhlu'"

#: ../libpq-oauth/oauth-curl.c:1142
msgid "could not parse token error response"
msgstr "ngoH Qagh jangghach pab yajlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:1170
#, c-format
msgid "provider rejected the oauth_client_secret"
msgstr "nobwI' oauth_client_secret Qo'lu'pu'"

#: ../libpq-oauth/oauth-curl.c:1171
#, c-format
msgid ""
"provider requires client authentication, and no oauth_client_secret is set"
msgstr ""
"nobwI'vaD tlhobwI' teHmoHghach poQlu', 'ach oauth_client_secret cherlu'pu'be'"

#: ../libpq-oauth/oauth-curl.c:1604
#, c-format
msgid "could not check timer expiration: %m"
msgstr "poH veH nuDlaHbe'pu': %m"

#: ../libpq-oauth/oauth-curl.c:1766
#, c-format
msgid "could not create libcurl multi handle"
msgstr "libcurl law' 'uchwI' chenmoHlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:1786
#, c-format
msgid "could not create libcurl handle"
msgstr "libcurl 'uchwI' chenmoHlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:1886
#, c-format
msgid "response is too large"
msgstr "jangghach tlhoy tIn"

#: ../libpq-oauth/oauth-curl.c:1928
#, c-format
msgid "could not queue HTTP request: %s"
msgstr "HTTP tlhobghach waQlaHbe'pu': %s"

#: ../libpq-oauth/oauth-curl.c:1945 ../libpq-oauth/oauth-curl.c:2003
#, c-format
msgid "asynchronous HTTP request failed: %s"
msgstr "poHHutlh HTTP tlhobghach lujpu': %s"

#: ../libpq-oauth/oauth-curl.c:2044
#, c-format
msgid "libcurl easy handle removal failed: %s"
msgstr "libcurl vemHa' 'uchwI' teqghach lujpu': %s"

#: ../libpq-oauth/oauth-curl.c:2055
#, c-format
msgid "no result was retrieved for the finished handle"
msgstr "rInpu'bogh 'uchwI'vaD chav Suqlu'pu'be'"

#: ../libpq-oauth/oauth-curl.c:2188 ../libpq-oauth/oauth-curl.c:2493
#: ../libpq-oauth/oauth-curl.c:2571
#, c-format
msgid "unexpected response code %ld"
msgstr "jangghach mI' pIHbe'bogh %ld"

#: ../libpq-oauth/oauth-curl.c:2195
msgid "could not parse OpenID discovery document"
msgstr "OpenID Sambogh ghItlh pab yajlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:2260
#, c-format
msgid "issuer identifier (%s) does not match oauth_issuer (%s)"
msgstr "nobwI' ngu'wI' (%s) oauth_issuer rapbe' (%s)"

#: ../libpq-oauth/oauth-curl.c:2287
#, c-format
msgid "issuer \"%s\" does not provide a device authorization endpoint"
msgstr "nobwI' \"%s\" De'wI' chaw'ghach Daq nobbe'"

#: ../libpq-oauth/oauth-curl.c:2313
#, c-format
msgid "device authorization endpoint \"%s\" must use HTTPS"
msgstr "De'wI' chaw'ghach Daq \"%s\" HTTPS lo'nIS"

#: ../libpq-oauth/oauth-curl.c:2322
#, c-format
msgid "token endpoint \"%s\" must use HTTPS"
msgstr "ngoH Daq \"%s\" HTTPS lo'nIS"

#: ../libpq-oauth/oauth-curl.c:2462
msgid "could not parse device authorization"
msgstr "De'wI' chaw'ghach pab yajlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:2549
msgid "could not parse access token response"
msgstr "'elmeH ngoH jangghach pab yajlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:2626
#, c-format
msgid "slow_down interval overflow"
msgstr "slow_down poH 'ay' tlhoy tIn"

#. translator: The first %s is a URL for the user to visit in a
#. browser, and the second %s is a code to be copy-pasted there.
#: ../libpq-oauth/oauth-curl.c:2662
#, c-format
msgid "Visit %s and enter the code: %s\n"
msgstr "%s yIghoS 'ej ngoH yI'el: %s\n"

#: ../libpq-oauth/oauth-curl.c:2667
#, c-format
msgid "device prompt failed"
msgstr "De'wI' tlhobghach lujpu'"

#: ../libpq-oauth/oauth-curl.c:2720
msgid "curl_global_init previously failed during OAuth setup"
msgstr "OAuth chenmoHghach ret curl_global_init lujpu'"

#: ../libpq-oauth/oauth-curl.c:2738
msgid "curl_global_init failed during OAuth setup"
msgstr "OAuth chenmoHghach curl_global_init lujpu'"

#: ../libpq-oauth/oauth-curl.c:2760
msgid ""
"libcurl is no longer thread-safe\n"
"\tCurl initialization was reported thread-safe when libpq\n"
"\twas compiled, but the currently installed version of\n"
"\tlibcurl reports that it is not. Recompile libpq against\n"
"\tthe installed version of libcurl."
msgstr ""
"libcurl bIr QaQ 'oHtaHbe'\n"
"\tlibpq chenmoHlu'taHvIS Curl chu'ghach bIr QaQ 'oH ja'lu'pu',\n"
"\t'ach DaH cherlu'pu'bogh libcurl mI' chu' pIm. libpq\n"
"\tcherlu'pu'bogh libcurl mI' chu' rap chenmoHqa'."

#: ../libpq-oauth/oauth-curl.c:2900
msgid "could not fetch OpenID discovery document"
msgstr "OpenID Sambogh ghItlh SuqlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:2914
msgid "cannot run OAuth device authorization"
msgstr "OAuth De'wI' chaw'ghach chu'laHbe'"

#: ../libpq-oauth/oauth-curl.c:2918
msgid "could not obtain device authorization"
msgstr "De'wI' chaw'ghach SuqlaHbe'pu'"

#: ../libpq-oauth/oauth-curl.c:2929 ../libpq-oauth/oauth-curl.c:2997
msgid "could not obtain access token"
msgstr "'elmeH ngoH SuqlaHbe'pu'"

#: fe-auth-oauth.c:140
#, c-format
msgid "internal error: no OAuth token was set for the connection"
msgstr "sum Qagh: rarghachvaD OAuth ngoH cherlu'pu'be'"

#: fe-auth-oauth.c:403
#, c-format
msgid "OAuth discovery URI \"%s\" must use HTTPS"
msgstr "OAuth Samghach URI \"%s\" HTTPS lo'nIS"

#: fe-auth-oauth.c:420
#, c-format
msgid "OAuth discovery URI \"%s\" must not contain query or fragment components"
msgstr "OAuth Samghach URI \"%s\" yu' 'ay' qoj wab 'ay' ngaSbe'nIS"

#: fe-auth-oauth.c:435
#, c-format
msgid "OAuth discovery URI \"%s\" is not a .well-known URI"
msgstr "OAuth Samghach URI \"%s\" .well-known URI 'oHbe'"

#: fe-auth-oauth.c:461
#, c-format
msgid "OAuth discovery URI \"%s\" uses an unsupported .well-known suffix"
msgstr "OAuth Samghach URI \"%s\" QaHlu'be'bogh .well-known mojaq lo'"

#: fe-auth-oauth.c:486
#, c-format
msgid "OAuth discovery URI \"%s\" uses an invalid format"
msgstr "OAuth Samghach URI \"%s\" lughbe'bogh Segh lo'"

#: fe-auth-oauth.c:535
#, c-format
msgid "server's error message contained an embedded NULL, and was discarded"
msgstr "toy'wI' Qagh QIn NULL qengbogh ngaSpu', 'ej Qaw'lu'pu'"

#: fe-auth-oauth.c:546
#, c-format
msgid "server's error response is not valid UTF-8"
msgstr "toy'wI' Qagh jangghach UTF-8 lughbe'"

#: fe-auth-oauth.c:586
#, c-format
msgid "failed to parse server's error response: %s"
msgstr "toy'wI' Qagh jangghach pab yajlaHbe'pu': %s"

#: fe-auth-oauth.c:617
#, c-format
msgid ""
"server's discovery document at %s (issuer \"%s\") is incompatible with "
"oauth_issuer (%s)"
msgstr "toy'wI' Sambogh ghItlh Daq %s (nobwI' \"%s\") oauth_issuer (%s) rapbe'"

#: fe-auth-oauth.c:638
#, c-format
msgid "server's discovery document has moved to %s (previous location was %s)"
msgstr "toy'wI' Sambogh ghItlh %s Daq ghoSta' (ret Daq %s 'oHpu')"

#: fe-auth-oauth.c:659
#, c-format
msgid "server sent error response without a status"
msgstr "toy'wI' Qagh jangghach ngeHta', Dotlh Hutlhbogh"

#: fe-auth-oauth.c:670
#, c-format
msgid "server rejected OAuth bearer token: %s"
msgstr "toy'wI' OAuth qembogh ngoH Qo'ta': %s"

#: fe-auth-oauth.c:717
msgid "user-defined OAuth flow failed"
msgstr "lo'wI' chenmoHbogh OAuth He lujpu'"

#: fe-auth-oauth.c:747
#, c-format
msgid "user-defined OAuth flow provided neither a token nor an async callback"
msgstr "lo'wI' chenmoHbogh OAuth He ngoH qoj poHHutlh jangmoHwI' nobbe'"

#: fe-auth-oauth.c:769
#, c-format
msgid "user-defined OAuth flow did not provide a token"
msgstr "lo'wI' chenmoHbogh OAuth He ngoH nobbe'"

#: fe-auth-oauth.c:788
#, c-format
msgid "user-defined OAuth flow did not provide a socket for polling"
msgstr "lo'wI' chenmoHbogh OAuth He nejtaHmeH rarwI' nobbe'"

#: fe-auth-oauth.c:932
msgid "could not find entry point for libpq-oauth"
msgstr "libpq-oauth vaD 'elmeH Daq SamlaHbe'pu'"

#: fe-auth-oauth.c:1097
#, c-format
msgid "no OAuth flows are available (try installing the libpq-oauth package)"
msgstr "OAuth He tu'lu'be' (libpq-oauth boS chellu'meH yInID)"

#: fe-auth-oauth.c:1141
#, c-format
msgid ""
"server requires OAuth authentication, but oauth_issuer and oauth_client_id "
"are not both set"
msgstr ""
"toy'wI' OAuth teHmoHghach poQ, 'ach oauth_issuer oauth_client_id je Hoch "
"cherlu'pu'be'"

#: fe-auth-oauth.c:1301
#, c-format
msgid "server sent unexpected additional OAuth data"
msgstr "toy'wI' latlh OAuth De' pIHbe'bogh ngeHta'"

#: fe-auth-oauth.c:1341
#, c-format
msgid ""
"server requires OAuth authentication, but no discovery metadata was provided"
msgstr "toy'wI' OAuth teHmoHghach poQ, 'ach Sambogh De' noblu'pu'be'"

#: fe-auth-oauth.c:1379
#, c-format
msgid "internal error: OAuth flow did not set a token"
msgstr "sum Qagh: OAuth He ngoH cherbe'"

#: fe-auth-oauth.c:1397
#, c-format
msgid "server sent additional OAuth data after error"
msgstr "toy'wI' Qagh veb latlh OAuth De' ngeHta'"

#: fe-auth-oauth.c:1401
#, c-format
msgid "invalid OAuth exchange state"
msgstr "OAuth jIjghach Dotlh lughbe'"

#: fe-auth-oauth.c:1414
#, c-format
msgid "retrying connection with new bearer token"
msgstr "chu' qembogh ngoH rarghach nIDqa'taH"

#: fe-auth-scram.c:228
#, c-format
msgid "malformed SCRAM message (empty message)"
msgstr "SCRAM QIn lughbe'bogh (QIn chImbogh)"

#: fe-auth-scram.c:233
#, c-format
msgid "malformed SCRAM message (length mismatch)"
msgstr "SCRAM QIn lughbe'bogh (nI' rapbe')"

#: fe-auth-scram.c:277
#, c-format
msgid "could not verify server signature: %s"
msgstr "toy'wI' teHghItlh teHmoHlaHbe'pu': %s"

#: fe-auth-scram.c:283
#, c-format
msgid "incorrect server signature"
msgstr "toy'wI' teHghItlh lughbe'"

#: fe-auth-scram.c:292
#, c-format
msgid "invalid SCRAM exchange state"
msgstr "SCRAM jIjghach Dotlh lughbe'"

#: fe-auth-scram.c:316
#, c-format
msgid "malformed SCRAM message (attribute \"%c\" expected)"
msgstr "SCRAM QIn lughbe'bogh (yotlh \"%c\" pIHlu'pu')"

#: fe-auth-scram.c:325
#, c-format
msgid "malformed SCRAM message (expected character \"=\" for attribute \"%c\")"
msgstr "SCRAM QIn lughbe'bogh (yotlh \"%c\" vaD ngutlh \"=\" pIHlu'pu')"

#: fe-auth-scram.c:365
#, c-format
msgid "could not generate nonce"
msgstr "wa'logh mI' chenmoHlaHbe'pu'"

#: fe-auth-scram.c:381
#, c-format
msgid "could not encode nonce"
msgstr "wa'logh mI' ngoqmoHlaHbe'pu'"

#: fe-auth-scram.c:569
#, c-format
msgid "could not calculate client proof: %s"
msgstr "tlhobwI' teHghach qellaHbe'pu': %s"

#: fe-auth-scram.c:584
#, c-format
msgid "could not encode client proof"
msgstr "tlhobwI' teHghach ngoqmoHlaHbe'pu'"

#: fe-auth-scram.c:636
#, c-format
msgid "invalid SCRAM response (nonce mismatch)"
msgstr "SCRAM jangghach lughbe' (wa'logh mI' rapbe')"

#: fe-auth-scram.c:666
#, c-format
msgid "malformed SCRAM message (invalid salt)"
msgstr "SCRAM QIn lughbe'bogh ('uj lughbe')"

#: fe-auth-scram.c:679
#, c-format
msgid "malformed SCRAM message (invalid iteration count)"
msgstr "SCRAM QIn lughbe'bogh (qaSqa' mI' lughbe')"

#: fe-auth-scram.c:684
#, c-format
msgid "malformed SCRAM message (garbage at end of server-first-message)"
msgstr "SCRAM QIn lughbe'bogh (toy'wI' wa'DIch QIn mev ghIm)"

#: fe-auth-scram.c:718
#, c-format
msgid "error received from server in SCRAM exchange: %s"
msgstr "SCRAM jIjghach Daq toy'wI' vo' Qagh Hevlu'pu': %s"

#: fe-auth-scram.c:733
#, c-format
msgid "malformed SCRAM message (garbage at end of server-final-message)"
msgstr "SCRAM QIn lughbe'bogh (toy'wI' mevDIch QIn mev ghIm)"

#: fe-auth-scram.c:750
#, c-format
msgid "malformed SCRAM message (invalid server signature)"
msgstr "SCRAM QIn lughbe'bogh (toy'wI' teHghItlh lughbe')"

#: fe-auth-scram.c:940
msgid "could not generate random salt"
msgstr "Sovbe'bogh 'uj chenmoHlaHbe'pu'"

#: fe-auth.c:80
#, c-format
msgid "out of memory allocating GSSAPI buffer (%d)"
msgstr "GSSAPI ngaSwI' nobtaHvIS qawHaq natlhlu'pu' (%d)"

#: fe-auth.c:146
msgid "GSSAPI continuation error"
msgstr "GSSAPI taHghach Qagh"

#: fe-auth.c:176 fe-auth.c:410 fe-gssapi-common.c:97 fe-secure-common.c:99
#: fe-secure-common.c:173
#, c-format
msgid "host name must be specified"
msgstr "De'wI' Daq pong cherlu'nIS"

#: fe-auth.c:182
#, c-format
msgid "duplicate GSS authentication request"
msgstr "cha' GSS teHmoHghach tlhobghach"

#: fe-auth.c:246
#, c-format
msgid "out of memory allocating SSPI buffer (%d)"
msgstr "SSPI ngaSwI' nobtaHvIS qawHaq natlhlu'pu' (%d)"

#: fe-auth.c:297
msgid "SSPI continuation error"
msgstr "SSPI taHghach Qagh"

#: fe-auth.c:372
#, c-format
msgid "duplicate SSPI authentication request"
msgstr "cha' SSPI teHmoHghach tlhobghach"

#: fe-auth.c:397
msgid "could not acquire SSPI credentials"
msgstr "SSPI teHmoHghach Doch SuqlaHbe'pu'"

#: fe-auth.c:449
#, c-format
msgid "channel binding required, but SSL not in use"
msgstr "He rarghach poQlu', 'ach SSL lo'lu'be'"

#: fe-auth.c:455
#, c-format
msgid "duplicate SASL authentication request"
msgstr "cha' SASL teHmoHghach tlhobghach"

#: fe-auth.c:513
#, c-format
msgid "channel binding is required, but client does not support it"
msgstr "He rarghach poQlu', 'ach tlhobwI' QaHbe'"

#: fe-auth.c:529
#, c-format
msgid ""
"server offered SCRAM-SHA-256-PLUS authentication over a non-SSL connection"
msgstr ""
"toy'wI' SSL lo'be'bogh rarghach Dung SCRAM-SHA-256-PLUS teHmoHghach nobpu'"

#: fe-auth.c:551
#, c-format
msgid "none of the server's SASL authentication mechanisms are supported"
msgstr "toy'wI' SASL teHmoHghach mIw Hoch QaHlu'be'"

#: fe-auth.c:571
#, c-format
msgid ""
"authentication method requirement \"%s\" failed: server requested %s "
"authentication"
msgstr "teHmoHghach mIw poQghach \"%s\" lujpu': toy'wI' %s teHmoHghach tlhobpu'"

#: fe-auth.c:580
#, c-format
msgid ""
"channel binding is required, but server did not offer an authentication "
"method that supports channel binding"
msgstr ""
"He rarghach poQlu', 'ach He rarghach QaHbogh teHmoHghach mIw toy'wI' "
"nobpu'be'"

#: fe-auth.c:716
#, c-format
msgid "out of memory allocating SASL buffer (%d)"
msgstr "SASL ngaSwI' nobtaHvIS qawHaq natlhlu'pu' (%d)"

#: fe-auth.c:758
#, c-format
msgid ""
"AuthenticationSASLFinal received from server, but SASL authentication was not"
" completed"
msgstr ""
"toy'wI' vo' AuthenticationSASLFinal Hevlu'pu', 'ach SASL teHmoHghach "
"rInpu'be'"

#: fe-auth.c:768
