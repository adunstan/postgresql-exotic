#: ../common/jsonapi.c:2484
msgid "Recursive descent parser cannot use incremental lexer."
msgstr "Rekursie-malsupreniĝa analizilo ne povas uzi pliigan leksilon."

#: ../common/jsonapi.c:2486
msgid "Incremental parser requires incremental lexer."
msgstr "Pliiga analizilo postulas pliigan leksilon."

#: ../common/jsonapi.c:2488
msgid "JSON nested too deep, maximum permitted depth is 6400."
msgstr ""
"JSON estas nestita tro profunde, la maksimuma permesata profundo estas 6400."

#: ../common/jsonapi.c:2490
#, c-format
msgid "Escape sequence \"\\%.*s\" is invalid."
msgstr "Eskapa sekvenco \"\\%.*s\" estas nevalida."

#: ../common/jsonapi.c:2494
#, c-format
msgid "Character with value 0x%02x must be escaped."
msgstr "Signo kun valoro 0x%02x devas esti eskapita."

#: ../common/jsonapi.c:2498
#, c-format
msgid "Expected end of input, but found \"%.*s\"."
msgstr "Atendis finon de enigo, sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2501
#, c-format
msgid "Expected array element or \"]\", but found \"%.*s\"."
msgstr "Atendis aran elementon aŭ \"]\", sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2504
#, c-format
msgid "Expected \",\" or \"]\", but found \"%.*s\"."
msgstr "Atendis \",\" aŭ \"]\", sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2507
#, c-format
msgid "Expected \":\", but found \"%.*s\"."
msgstr "Atendis \":\", sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2510
#, c-format
msgid "Expected JSON value, but found \"%.*s\"."
msgstr "Atendis JSON-valoron, sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2513
msgid "The input string ended unexpectedly."
msgstr "La eniga ĉeno finiĝis neatendite."

#: ../common/jsonapi.c:2515
#, c-format
msgid "Expected string or \"}\", but found \"%.*s\"."
msgstr "Atendis ĉenon aŭ \"}\", sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2518
#, c-format
msgid "Expected \",\" or \"}\", but found \"%.*s\"."
msgstr "Atendis \",\" aŭ \"}\", sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2521
#, c-format
msgid "Expected string, but found \"%.*s\"."
msgstr "Atendis ĉenon, sed trovis \"%.*s\"."

#: ../common/jsonapi.c:2524
#, c-format
msgid "Token \"%.*s\" is invalid."
msgstr "Ĵetono \"%.*s\" estas nevalida."

#: ../common/jsonapi.c:2530
msgid "\\u0000 cannot be converted to text."
msgstr "\\u0000 ne povas esti konvertita al text."

#: ../common/jsonapi.c:2532
msgid "\"\\u\" must be followed by four hexadecimal digits."
msgstr "\"\\u\" devas esti sekvata de kvar deksesumaj ciferoj."

#: ../common/jsonapi.c:2535
msgid ""
"Unicode escape values cannot be used for code point values above 007F when "
"the encoding is not UTF8."
msgstr ""
"Unicode-aj eskapaj valoroj ne povas esti uzataj por kodpunktaj valoroj super "
"007F, kiam la kodigo ne estas UTF8."

#: ../common/jsonapi.c:2544
#, c-format
msgid ""
"Unicode escape value could not be translated to the server's encoding %s."
msgstr ""
"Unicode-a eskapa valoro ne povis esti tradukita al la kodigo de la servilo "
"%s."

#: ../common/jsonapi.c:2551
msgid "Unicode high surrogate must not follow a high surrogate."
msgstr "Unicode-a alta anstataŭanto ne devas sekvi altan anstataŭanton."

#: ../common/jsonapi.c:2553
msgid "Unicode low surrogate must follow a high surrogate."
msgstr "Unicode-a malalta anstataŭanto devas sekvi altan anstataŭanton."

