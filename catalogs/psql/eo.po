"  \\getresults [NUM_RES]  read NUM_RES pending results, or all if no "
"argument\n"
msgstr ""
"  \\getresults [NUM_RES]  legi NUM_RES atendantajn rezultojn, aŭ ĉiujn se "
"neniu argumento\n"

#: help.c:339
msgid "  \\parse STMT_NAME       create a prepared statement\n"
msgstr "  \\parse STMT_NAME       krei preparitan ordonon\n"

#: help.c:340
msgid "  \\sendpipeline          send an extended query to an ongoing pipeline\n"
msgstr "  \\sendpipeline          sendi etenditan demandon al daŭranta dukto\n"

#: help.c:341
msgid "  \\startpipeline         enter pipeline mode\n"
msgstr "  \\startpipeline         eniri la dukto-reĝimon\n"

#: help.c:342
msgid ""
"  \\syncpipeline          add a synchronisation point to an ongoing "
"pipeline\n"
msgstr "  \\syncpipeline          aldoni sinkronigan punkton al daŭranta dukto\n"

#: help.c:381
msgid ""
"List of specially treated variables\n"
"\n"
msgstr ""
"Listo de speciale traktataj variabloj\n"
"\n"

#: help.c:383
msgid "psql variables:\n"
msgstr "psql-variabloj:\n"

#: help.c:385
msgid ""
"  psql --set=NAME=VALUE\n"
"  or \\set NAME VALUE inside psql\n"
"\n"
msgstr ""
"  psql --set=NAME=VALUE\n"
"  aŭ \\set NAME VALUE interne de psql\n"
"\n"

#: help.c:387
msgid ""
"  AUTOCOMMIT\n"
"    if set, successful SQL commands are automatically committed\n"
msgstr ""
"  AUTOCOMMIT\n"
"    se agordita, sukcesaj SQL-komandoj estas aŭtomate konfirmataj\n"

#: help.c:389
msgid ""
"  COMP_KEYWORD_CASE\n"
"    determines the case used to complete SQL key words\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"
msgstr ""
"  COMP_KEYWORD_CASE\n"
"    determinas la usklon uzatan por kompletigi SQL-ŝlosilvortojn\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"

#: help.c:392
msgid ""
"  DBNAME\n"
"    the currently connected database name\n"
msgstr ""
"  DBNAME\n"
"    la nomo de la nuntempe konektita datumbazo\n"

#: help.c:394
msgid ""
"  ECHO\n"
"    controls what input is written to standard output\n"
"    [all, errors, none, queries]\n"
msgstr ""
"  ECHO\n"
"    regas kio el la enigo estas skribata al norma eligo\n"
"    [all, errors, none, queries]\n"

#: help.c:397
msgid ""
"  ECHO_HIDDEN\n"
"    if set, display internal queries executed by backslash commands;\n"
"    if set to \"noexec\", just show them without execution\n"
msgstr ""
"  ECHO_HIDDEN\n"
"    se agordita, montri internajn demandojn plenumitajn de retroklinkomandoj;\n"
"    se agordita al \"noexec\", nur montri ilin sen plenumo\n"

#: help.c:400
msgid ""
"  ENCODING\n"
"    current client character set encoding\n"
msgstr ""
"  ENCODING\n"
"    nuna signara kodigo de la kliento\n"

#: help.c:402
msgid ""
"  ERROR\n"
"    \"true\" if last query failed, else \"false\"\n"
msgstr ""
"  ERROR\n"
"    \"true\" se la lasta demando malsukcesis, alie \"false\"\n"

#: help.c:404
msgid ""
"  FETCH_COUNT\n"
"    the number of result rows to fetch and display at a time (0 = unlimited)\n"
msgstr ""
"  FETCH_COUNT\n"
"    la nombro de rezultaj vicoj por akiri kaj montri per fojo (0 = senlima)\n"

#: help.c:406
msgid ""
"  HIDE_TABLEAM\n"
"    if set, table access methods are not displayed\n"
msgstr ""
"  HIDE_TABLEAM\n"
"    se agordita, tabelaj alirmetodoj ne estas montrataj\n"

#: help.c:408
msgid ""
"  HIDE_TOAST_COMPRESSION\n"
"    if set, compression methods are not displayed\n"
msgstr ""
"  HIDE_TOAST_COMPRESSION\n"
"    se agordita, densigaj metodoj ne estas montrataj\n"

#: help.c:410
msgid ""
"  HISTCONTROL\n"
"    controls command history [ignorespace, ignoredups, ignoreboth]\n"
msgstr ""
"  HISTCONTROL\n"
"    regas la komandohistorion [ignorespace, ignoredups, ignoreboth]\n"

#: help.c:412
msgid ""
"  HISTFILE\n"
"    file name used to store the command history\n"
msgstr ""
"  HISTFILE\n"
"    dosiernomo uzata por konservi la komandohistorion\n"

#: help.c:414
msgid ""
"  HISTSIZE\n"
"    maximum number of commands to store in the command history\n"
msgstr ""
"  HISTSIZE\n"
"    maksimuma nombro da komandoj konservotaj en la komandohistorio\n"

#: help.c:416
msgid ""
"  HOST\n"
"    the currently connected database server host\n"
msgstr ""
"  HOST\n"
"    la gastiganto de la nuntempe konektita datumbaza servilo\n"

#: help.c:418
msgid ""
"  IGNOREEOF\n"
"    number of EOFs needed to terminate an interactive session\n"
msgstr ""
"  IGNOREEOF\n"
"    nombro da EOFs necesaj por fini interagan seancon\n"

#: help.c:420
msgid ""
"  LASTOID\n"
"    value of the last affected OID\n"
msgstr ""
"  LASTOID\n"
"    valoro de la lasta trafita OID\n"

#: help.c:422
msgid ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    message and SQLSTATE of last error, or empty string and \"00000\" if none\n"
msgstr ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    mesaĝo kaj SQLSTATE de la lasta eraro, aŭ malplena ĉeno kaj \"00000\" se neniu\n"

#: help.c:425
msgid ""
"  ON_ERROR_ROLLBACK\n"
"    if set, an error doesn't stop a transaction (uses implicit savepoints)\n"
msgstr ""
"  ON_ERROR_ROLLBACK\n"
"    se agordita, eraro ne ĉesigas transakcion (uzas implicajn savpunktojn)\n"

#: help.c:427
msgid ""
"  ON_ERROR_STOP\n"
"    stop batch execution after error\n"
msgstr ""
"  ON_ERROR_STOP\n"
"    ĉesigi staplan plenumon post eraro\n"

#: help.c:429
msgid ""
"  PORT\n"
"    server port of the current connection\n"
msgstr ""
"  PORT\n"
"    servila pordo de la nuna konekto\n"

#: help.c:431
msgid ""
"  PROMPT1\n"
"    specifies the standard psql prompt\n"
msgstr ""
"  PROMPT1\n"
"    specifas la norman invitilon de psql\n"

#: help.c:433
msgid ""
"  PROMPT2\n"
"    specifies the prompt used when a statement continues from a previous line\n"
msgstr ""
"  PROMPT2\n"
"    specifas la invitilon uzatan kiam ordono daŭras de antaŭa linio\n"

#: help.c:435
msgid ""
"  PROMPT3\n"
"    specifies the prompt used during COPY ... FROM STDIN\n"
msgstr ""
"  PROMPT3\n"
"    specifas la invitilon uzatan dum COPY ... FROM STDIN\n"

#: help.c:437
msgid ""
"  QUIET\n"
"    run quietly (same as -q option)\n"
msgstr ""
"  QUIET\n"
"    ruli silente (sama kiel la opcio -q)\n"

#: help.c:439
msgid ""
"  ROW_COUNT\n"
"    number of rows returned or affected by last query, or 0\n"
msgstr ""
"  ROW_COUNT\n"
"    nombro da vicoj redonitaj aŭ trafitaj de la lasta demando, aŭ 0\n"

#: help.c:441
msgid ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    server's version (in short string or numeric format)\n"
msgstr ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    la versio de la servilo (en mallonga ĉeno aŭ numera formato)\n"

#: help.c:444
msgid ""
"  SHELL_ERROR\n"
"    \"true\" if the last shell command failed, \"false\" if it succeeded\n"
msgstr ""
"  SHELL_ERROR\n"
"    \"true\" se la lasta ŝela komando malsukcesis, \"false\" se ĝi sukcesis\n"

#: help.c:446
msgid ""
"  SHELL_EXIT_CODE\n"
"    exit status of the last shell command\n"
msgstr ""
"  SHELL_EXIT_CODE\n"
"    elira stato de la lasta ŝela komando\n"

#: help.c:448
msgid ""
"  SHOW_ALL_RESULTS\n"
"    show all results of a combined query (\\;) instead of only the last\n"
msgstr ""
"  SHOW_ALL_RESULTS\n"
"    montri ĉiujn rezultojn de kombinita demando (\\;) anstataŭ nur la lastan\n"

#: help.c:450
msgid ""
"  SHOW_CONTEXT\n"
"    controls display of message context fields [never, errors, always]\n"
msgstr ""
"  SHOW_CONTEXT\n"
"    regas la montron de kampoj de mesaĝa kunteksto [never, errors, always]\n"

#: help.c:452
msgid ""
"  SINGLELINE\n"
"    if set, end of line terminates SQL commands (same as -S option)\n"
msgstr ""
"  SINGLELINE\n"
"    se agordita, fino de linio finas SQL-komandojn (sama kiel la opcio -S)\n"

#: help.c:454
msgid ""
"  SINGLESTEP\n"
"    single-step mode (same as -s option)\n"
msgstr ""
"  SINGLESTEP\n"
"    unuopaŝa reĝimo (sama kiel la opcio -s)\n"

#: help.c:456
msgid ""
"  SQLSTATE\n"
"    SQLSTATE of last query, or \"00000\" if no error\n"
msgstr ""
"  SQLSTATE\n"
"    SQLSTATE de la lasta demando, aŭ \"00000\" se neniu eraro\n"

#: help.c:458
msgid ""
"  USER\n"
"    the currently connected database user\n"
msgstr ""
"  USER\n"
"    la nuntempe konektita datumbaza uzanto\n"

#: help.c:460
msgid ""
"  VERBOSITY\n"
"    controls verbosity of error reports [default, verbose, terse, sqlstate]\n"
msgstr ""
"  VERBOSITY\n"
"    regas la detalecon de eraraj raportoj [default, verbose, terse, sqlstate]\n"

#: help.c:462
msgid ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql's version (in verbose string, short string, or numeric format)\n"
msgstr ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    la versio de psql (en detala ĉeno, mallonga ĉeno, aŭ numera formato)\n"

#: help.c:466
#, c-format
msgid ""
"  WATCH_INTERVAL\n"
"    number of seconds \\watch waits between executions (default %s)\n"
msgstr ""
"  WATCH_INTERVAL\n"
"    nombro da sekundoj kiujn \\watch atendas inter plenumoj (defaŭlte %s)\n"

#: help.c:470
msgid ""
"\n"
"Display settings:\n"
msgstr ""
"\n"
"Agordoj de montrado:\n"

#: help.c:472
msgid ""
"  psql --pset=NAME[=VALUE]\n"
"  or \\pset NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  psql --pset=NAME[=VALUE]\n"
"  aŭ \\pset NAME [VALUE] interne de psql\n"
"\n"

#: help.c:474
msgid ""
"  border\n"
"    border style (number)\n"
msgstr ""
"  border\n"
"    bordera stilo (nombro)\n"

#: help.c:476
msgid ""
"  columns\n"
"    target width for the wrapped format\n"
msgstr ""
"  columns\n"
"    cela larĝo por la faldita formato\n"

#: help.c:478
#, c-format
msgid ""
"  csv_fieldsep\n"
"    field separator for CSV output format (default \"%c\")\n"
msgstr ""
"  csv_fieldsep\n"
"    kampa apartigilo por CSV-eliga formato (defaŭlte \"%c\")\n"

#: help.c:481
msgid ""
"  display_false\n"
"    set the string to be printed in place of a Boolean \"false\"\n"
msgstr ""
"  display_false\n"
"    agordi la ĉenon presotan anstataŭ bulea \"false\"\n"

#: help.c:483
msgid ""
"  display_true\n"
"    set the string to be printed in place of a Boolean \"true\"\n"
msgstr ""
"  display_true\n"
"    agordi la ĉenon presotan anstataŭ bulea \"true\"\n"

#: help.c:485
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr ""
"  expanded (aŭ x)\n"
"    etendita eligo [on, off, auto]\n"

#: help.c:487
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr ""
"  fieldsep\n"
"    kampa apartigilo por nevicigita eligo (defaŭlte \"%s\")\n"

#: help.c:490
msgid ""
"  fieldsep_zero\n"
"    set field separator for unaligned output to a zero byte\n"
msgstr ""
"  fieldsep_zero\n"
"    agordi kampan apartigilon por nevicigita eligo al nula bajto\n"

#: help.c:492
msgid ""
"  footer\n"
"    enable or disable display of the table footer [on, off]\n"
msgstr ""
"  footer\n"
"    ebligi aŭ malebligi la montron de la tabela piedo [on, off]\n"

#: help.c:494
msgid ""
"  format\n"
"    set output format [unaligned, aligned, wrapped, html, asciidoc, ...]\n"
msgstr ""
"  format\n"
"    agordi la eligan formaton [unaligned, aligned, wrapped, html, asciidoc, ...]\n"

#: help.c:496
msgid ""
"  linestyle\n"
"    set the border line drawing style [ascii, old-ascii, unicode]\n"
msgstr ""
"  linestyle\n"
"    agordi la desegnan stilon de la borderaj linioj [ascii, old-ascii, unicode]\n"

#: help.c:498
msgid ""
"  null\n"
"    set the string to be printed in place of a null value\n"
msgstr ""
"  null\n"
"    agordi la ĉenon presotan anstataŭ nula valoro\n"

#: help.c:500
msgid ""
"  numericlocale\n"
"    enable display of a locale-specific character to separate groups of digits\n"
msgstr ""
"  numericlocale\n"
"    ebligi la montron de lokaĵar-specifa signo por apartigi grupojn da ciferoj\n"

#: help.c:502
msgid ""
"  pager\n"
"    control when an external pager is used [yes, no, always]\n"
msgstr ""
"  pager\n"
"    regas kiam ekstera paĝigilo estas uzata [yes, no, always]\n"

#: help.c:504
msgid ""
"  recordsep\n"
"    record (line) separator for unaligned output\n"
msgstr ""
"  recordsep\n"
"    rikorda (linia) apartigilo por nevicigita eligo\n"

#: help.c:506
msgid ""
"  recordsep_zero\n"
"    set record separator for unaligned output to a zero byte\n"
msgstr ""
"  recordsep_zero\n"
"    agordi rikordan apartigilon por nevicigita eligo al nula bajto\n"

#: help.c:508
msgid ""
"  tableattr (or T)\n"
"    specify attributes for table tag in html format, or proportional\n"
"    column widths for left-aligned data types in latex-longtable format\n"
msgstr ""
"  tableattr (aŭ T)\n"
"    specifi atributojn por tabela etikedo en html-formato, aŭ proporciajn\n"
"    kolumnajn larĝojn por maldekstre-vicigitaj datumtipoj en latex-longtable-formato\n"

#: help.c:511
msgid ""
"  title\n"
"    set the table title for subsequently printed tables\n"
msgstr ""
"  title\n"
"    agordi la tabelan titolon por poste presotaj tabeloj\n"

#: help.c:513
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr ""
"  tuples_only\n"
"    se agordita, nur efektivaj tabelaj datumoj estas montrataj\n"

#: help.c:515
msgid ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    set the style of Unicode line drawing [single, double]\n"
msgstr ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    agordi la stilon de Unicode-liniodesegnoj [single, double]\n"

#: help.c:519
msgid ""
"  xheader_width\n"
"    set the maximum width of the header for expanded output\n"
"    [full, column, page, integer value]\n"
msgstr ""
"  xheader_width\n"
"    agordi la maksimuman larĝon de la kaplinio por etendita eligo\n"
"    [full, column, page, entjera valoro]\n"

#: help.c:523
msgid ""
"\n"
"Environment variables:\n"
msgstr ""
"\n"
"Mediaj variabloj:\n"

#: help.c:527
msgid ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  aŭ \\setenv NAME [VALUE] interne de psql\n"
"\n"

#: help.c:529
msgid ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  aŭ \\setenv NAME [VALUE] interne de psql\n"
"\n"

#: help.c:532
msgid ""
"  COLUMNS\n"
"    number of columns for wrapped format\n"
msgstr ""
"  COLUMNS\n"
"    nombro da kolumnoj por faldita formato\n"

#: help.c:534
msgid ""
"  PGAPPNAME\n"
"    same as the application_name connection parameter\n"
msgstr ""
"  PGAPPNAME\n"
"    sama kiel la konekta parametro application_name\n"

#: help.c:536
msgid ""
"  PGDATABASE\n"
"    same as the dbname connection parameter\n"
msgstr ""
"  PGDATABASE\n"
"    sama kiel la konekta parametro dbname\n"

#: help.c:538
msgid ""
"  PGHOST\n"
"    same as the host connection parameter\n"
msgstr ""
"  PGHOST\n"
"    sama kiel la konekta parametro host\n"

#: help.c:540
msgid ""
"  PGPASSFILE\n"
"    password file name\n"
msgstr ""
"  PGPASSFILE\n"
"    nomo de la pasvorta dosiero\n"

#: help.c:542
msgid ""
"  PGPASSWORD\n"
"    connection password (not recommended)\n"
msgstr ""
"  PGPASSWORD\n"
"    konekta pasvorto (ne rekomendata)\n"

#: help.c:544
msgid ""
"  PGPORT\n"
"    same as the port connection parameter\n"
msgstr ""
"  PGPORT\n"
"    sama kiel la konekta parametro port\n"

#: help.c:546
msgid ""
"  PGUSER\n"
"    same as the user connection parameter\n"
msgstr ""
"  PGUSER\n"
"    sama kiel la konekta parametro user\n"

#: help.c:548
msgid ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    editor used by the \\e, \\ef, and \\ev commands\n"
msgstr ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    redaktilo uzata de la komandoj \\e, \\ef, kaj \\ev\n"

#: help.c:550
msgid ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    how to specify a line number when invoking the editor\n"
msgstr ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    kiel specifi lininombron kiam oni vokas la redaktilon\n"

#: help.c:552
msgid ""
"  PSQL_HISTORY\n"
"    alternative location for the command history file\n"
msgstr ""
"  PSQL_HISTORY\n"
"    alternativa loko por la dosiero de komandohistorio\n"

#: help.c:554
msgid ""
"  PSQL_PAGER, PAGER\n"
"    name of external pager program\n"
msgstr ""
"  PSQL_PAGER, PAGER\n"
"    nomo de ekstera paĝigila programo\n"

#: help.c:557
msgid ""
"  PSQL_WATCH_PAGER\n"
"    name of external pager program used for \\watch\n"
msgstr ""
"  PSQL_WATCH_PAGER\n"
"    nomo de ekstera paĝigila programo uzata por \\watch\n"

#: help.c:560
msgid ""
"  PSQLRC\n"
"    alternative location for the user's .psqlrc file\n"
msgstr ""
"  PSQLRC\n"
"    alternativa loko por la dosiero .psqlrc de la uzanto\n"

#: help.c:562
msgid ""
"  SHELL\n"
"    shell used by the \\! command\n"
msgstr ""
"  SHELL\n"
"    ŝelo uzata de la komando \\!\n"

#: help.c:564
msgid ""
"  TMPDIR\n"
"    directory for temporary files\n"
msgstr ""
"  TMPDIR\n"
"    dosierujo por provizoraj dosieroj\n"

