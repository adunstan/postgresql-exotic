#: help.c:60
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr ""
"psql estas la interaga terminalo de PostgreSQL.\n"
"\n"

#: help.c:61 help.c:384 help.c:471 help.c:524
msgid "Usage:\n"
msgstr "Uzado:\n"

#: help.c:62
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"

#: help.c:64
msgid "General options:\n"
msgstr "Ĝeneralaj opcioj:\n"

#: help.c:65
msgid ""
"  -c, --command=COMMAND    run only single command (SQL or internal) and "
"exit\n"
msgstr ""
"  -c, --command=COMMAND    ruli nur unu komandon (SQL aŭ internan) kaj "
"eliri\n"

#: help.c:66
msgid "  -d, --dbname=DBNAME      database name to connect to\n"
msgstr "  -d, --dbname=DBNAME      nomo de la datumbazo al kiu konekti\n"

#: help.c:67
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr "  -f, --file=FILENAME      plenumi komandojn el dosiero, poste eliri\n"

#: help.c:68
msgid "  -l, --list               list available databases, then exit\n"
msgstr "  -l, --list               listigi haveblajn datumbazojn, poste eliri\n"

#: help.c:69
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           agordi la psql-variablon NAME al VALUE\n"
"                           (ekz., -v ON_ERROR_STOP=1)\n"

#: help.c:72
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            eligi versian informon, poste eliri\n"

#: help.c:73
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr "  -X, --no-psqlrc          ne legi la eklegan dosieron (~/.psqlrc)\n"

#: help.c:74
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-interactive)\n"
msgstr ""
"  -1 (\"one\"), --single-transaction\n"
"                           plenumi kiel unu transakcio (se ne interaga)\n"

#: help.c:76
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr "  -?, --help[=options]     montri ĉi tiun helpon, poste eliri\n"

#: help.c:77
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr "      --help=commands      listigi retroklinajn komandojn, poste eliri\n"

#: help.c:78
msgid "      --help=variables     list special variables, then exit\n"
msgstr "      --help=variables     listigi specialajn variablojn, poste eliri\n"

#: help.c:80
msgid ""
"\n"
"Input and output options:\n"
msgstr ""
"\n"
"Opcioj de enigo kaj eligo:\n"

#: help.c:81
msgid "  -a, --echo-all           echo all input from script\n"
msgstr "  -a, --echo-all           eĥi la tutan enigon el skripto\n"

#: help.c:82
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr "  -b, --echo-errors        eĥi malsukcesajn komandojn\n"

#: help.c:83
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr "  -e, --echo-queries       eĥi komandojn senditajn al la servilo\n"

#: help.c:84
msgid ""
"  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr ""
"  -E, --echo-hidden        montri demandojn kiujn internaj komandoj generas\n"

#: help.c:85
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr "  -L, --log-file=FILENAME  sendi seancan protokolon al dosiero\n"

#: help.c:86
msgid ""
"  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr ""
"  -n, --no-readline        malŝalti plibonigitan redaktadon de komandlinio "
"(readline)\n"

#: help.c:87
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr ""
"  -o, --output=FILENAME    sendi demandorezultojn al dosiero (aŭ |dukto)\n"

#: help.c:88
msgid "  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr ""
"  -q, --quiet              ruli silente (neniuj mesaĝoj, nur eligo de "
"demando)\n"

#: help.c:89
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr "  -s, --single-step        unupaŝa reĝimo (konfirmi ĉiun demandon)\n"

#: help.c:90
msgid ""
"  -S, --single-line        single-line mode (end of line terminates SQL "
"command)\n"
msgstr ""
"  -S, --single-line        unulinia reĝimo (fino de linio finas SQL-"
"komandon)\n"

#: help.c:92
msgid ""
"\n"
"Output format options:\n"
msgstr ""
"\n"
"Opcioj pri eliga formato:\n"

#: help.c:93
msgid "  -A, --no-align           unaligned table output mode\n"
msgstr "  -A, --no-align           reĝimo de nealigita tabela eligo\n"

#: help.c:94
msgid ""
"      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr ""
"      --csv                CSV (komo-apartigitaj valoroj) reĝimo de tabela "
"eligo\n"

#: help.c:95
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
"                           field separator for unaligned output (default: \"%s\")\n"
msgstr ""
"  -F, --field-separator=STRING\n"
"                           kampo-apartigilo por nealigita eligo (defaŭlte: \"%s\")\n"

#: help.c:98
msgid "  -H, --html               HTML table output mode\n"
msgstr "  -H, --html               HTML-reĝimo de tabela eligo\n"

#: help.c:99
msgid ""
"  -P, --pset=VAR[=ARG]     set printing option VAR to ARG (see \\pset "
"command)\n"
msgstr ""
"  -P, --pset=VAR[=ARG]     agordi presan opcion VAR al ARG (vidu la komandon "
"\\pset)\n"

#: help.c:100
msgid ""
"  -R, --record-separator=STRING\n"
"                           record separator for unaligned output (default: newline)\n"
msgstr ""
"  -R, --record-separator=STRING\n"
"                           rikordo-apartigilo por nealigita eligo (defaŭlte: novlinio)\n"

#: help.c:102
msgid "  -t, --tuples-only        print rows only\n"
msgstr "  -t, --tuples-only        presi nur vicojn\n"

#: help.c:103
msgid ""
"  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, "
"border)\n"
msgstr ""
"  -T, --table-attr=TEXT    agordi atributojn de HTML-tabela etikedo (ekz., "
"width, border)\n"

#: help.c:104
msgid "  -x, --expanded           turn on expanded table output\n"
msgstr "  -x, --expanded           enŝalti vastigitan tabelan eligon\n"

#: help.c:105
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero byte\n"
msgstr ""
"  -z, --field-separator-zero\n"
"                           agordi kampo-apartigilon por nealigita eligo al nula bajto\n"

#: help.c:107
msgid ""
"  -0, --record-separator-zero\n"
"                           set record separator for unaligned output to zero byte\n"
msgstr ""
"  -0, --record-separator-zero\n"
"                           agordi rikordo-apartigilon por nealigita eligo al nula bajto\n"

#: help.c:110
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"Opcioj de konekto:\n"

#: help.c:111
msgid "  -h, --host=HOSTNAME      database server host or socket directory\n"
msgstr ""
"  -h, --host=HOSTNAME      gastiganto de la datumbaza servilo aŭ dosierujo de"
" soketo\n"

#: help.c:112
msgid "  -p, --port=PORT          database server port\n"
msgstr "  -p, --port=PORT          pordo de la datumbaza servilo\n"

#: help.c:113
msgid "  -U, --username=USERNAME  database user name\n"
msgstr "  -U, --username=USERNAME  nomo de datumbaza uzanto\n"

#: help.c:114
msgid "  -w, --no-password        never prompt for password\n"
msgstr "  -w, --no-password        neniam peti pasvorton\n"

#: help.c:115
msgid ""
"  -W, --password           force password prompt (should happen "
"automatically)\n"
msgstr ""
"  -W, --password           devigi peton pri pasvorto (tio okazu aŭtomate)\n"

#: help.c:117
msgid ""
"\n"
"For more information, type \"\\?\" (for internal commands) or \"\\help\" (for SQL\n"
"commands) from within psql, or consult the psql section in the PostgreSQL\n"
"documentation.\n"
"\n"
msgstr ""
"\n"
"Por pli da informo, tajpu \"\\?\" (por internaj komandoj) aŭ \"\\help\" (por SQL-\n"
"komandoj) interne de psql, aŭ konsultu la sekcion pri psql en la dokumentado de PostgreSQL.\n"
"\n"

#: help.c:120
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "Raportu cimojn al <%s>.\n"

#: help.c:121
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s hejmpaĝo: <%s>\n"

#: help.c:163
msgid "General\n"
msgstr "Ĝenerala\n"

#: help.c:164
msgid "  \\copyright             show PostgreSQL usage and distribution terms\n"
msgstr ""
"  \\copyright             montri la uzadon kaj distribuokondiĉojn de "
"PostgreSQL\n"

#: help.c:165
msgid "  \\crosstabview [COLUMNS] execute query and display result in crosstab\n"
msgstr ""
"  \\crosstabview [COLUMNS] plenumi demandon kaj montri rezulton en "
"krucotabelo\n"

#: help.c:166
msgid ""
"  \\errverbose            show most recent error message at maximum "
"verbosity\n"
msgstr ""
"  \\errverbose            montri la plej lastan eraromesaĝon ĉe maksimuma "
"detaleco\n"

#: help.c:167
msgid ""
"  \\g [(OPTIONS)] [FILE]  execute query (and send result to file or |pipe);\n"
"                         \\g with no arguments is equivalent to a semicolon\n"
msgstr ""
"  \\g [(OPTIONS)] [FILE]  plenumi demandon (kaj sendi rezulton al dosiero aŭ |dukto);\n"
"                         \\g sen argumentoj estas ekvivalenta al punktokomo\n"

#: help.c:169
