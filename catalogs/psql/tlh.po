msgstr "  -A, --no-align           rurbe'bogh ghItlh mI' mejghach Dotlh\n"

#: help.c:94
msgid ""
"      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr ""
"      --csv                CSV (Comma-Separated Values) ghItlh mI' mejghach "
"Dotlh\n"

#: help.c:95
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
