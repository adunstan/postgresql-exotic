msgstr "  -x, --expanded           tInmoHlu'pu'bogh ghItlh mI' mejghach chu'\n"

#: help.c:105
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero byte\n"
msgstr ""
"  -z, --field-separator-zero\n"
"                           rurbe'bogh mejghach vaD yotlh jomwI' pagh bIt cher\n"

#: help.c:107
