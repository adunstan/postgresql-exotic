msgstr ""
"  -R, --record-separator=STRING\n"
"                           rurbe'bogh mejghach vaD ta jomwI' (motlh: tlhegh chu')\n"

#: help.c:102
msgid "  -t, --tuples-only        print rows only\n"
msgstr "  -t, --tuples-only        tlheghmey neH HonmoH\n"

#: help.c:103
msgid ""
"  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, "
