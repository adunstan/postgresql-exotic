#: help.c:60
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr ""
"psql 'oH PostgreSQL jatlhchuqbogh mIw ngoq'e'.\n"
"\n"

#: help.c:61 help.c:384 help.c:471 help.c:524
msgid "Usage:\n"
msgstr "lo'ghach:\n"

#: help.c:62
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"

#: help.c:64
msgid "General options:\n"
msgstr "Hoch wIvmeHmey:\n"

#: help.c:65
msgid ""
"  -c, --command=COMMAND    run only single command (SQL or internal) and "
"exit\n"
msgstr "  -c, --command=COMMAND    ra' wa' neH (SQL qoj toqDu') chu' 'ej mej\n"

#: help.c:66
msgid "  -d, --dbname=DBNAME      database name to connect to\n"
msgstr "  -d, --dbname=DBNAME      rarmeH De' pa' pong\n"

#: help.c:67
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr "  -f, --file=FILENAME      ta vo' ra'mey chu' 'ej mej\n"

#: help.c:68
msgid "  -l, --list               list available databases, then exit\n"
msgstr "  -l, --list               lo'laHbogh De' pa'mey tetlhmoH 'ej mej\n"

#: help.c:69
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           psql choHlaHbogh NAME VALUE cher\n"
"                           (lut., -v ON_ERROR_STOP=1)\n"

#: help.c:72
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            mI' chu' De' mejmoH 'ej mej\n"

#: help.c:73
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr "  -X, --no-psqlrc          chu'ghach ta (~/.psqlrc) laDbe'\n"

#: help.c:74
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-interactive)\n"
msgstr ""
"  -1 (\"one\"), --single-transaction\n"
"                           ta' mIr wa' neH rur chu' (jatlhchuqbe'chugh)\n"

#: help.c:76
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr "  -?, --help[=options]     QaH vam ja' 'ej mej\n"

#: help.c:77
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr "      --help=commands      tlhIl ra'mey tetlhmoH 'ej mej\n"

#: help.c:78
msgid "      --help=variables     list special variables, then exit\n"
msgstr ""
"      --help=variables     motlhbe'bogh choHlaHboghmey tetlhmoH 'ej mej\n"

#: help.c:80
msgid ""
"\n"
"Input and output options:\n"
msgstr ""
"\n"
"'elghach mejghach je wIvmeHmey:\n"

#: help.c:81
msgid "  -a, --echo-all           echo all input from script\n"
msgstr "  -a, --echo-all           ghItlh mIw vo' Hoch 'elghach chIl\n"

#: help.c:82
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr "  -b, --echo-errors        lujpu'bogh ra'mey chIl\n"

#: help.c:83
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr "  -e, --echo-queries       toy'wI'vaD ngeHlu'pu'bogh ra'mey chIl\n"

#: help.c:84
msgid ""
"  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr "  -E, --echo-hidden        toqDu' ra'mey chenmoHbogh yu'ghachmey ja'\n"

#: help.c:85
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr "  -L, --log-file=FILENAME  ta vaD ghom qonta ngeH\n"

#: help.c:86
msgid ""
"  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr ""
"  -n, --no-readline        QaQmoHlu'pu'bogh ra' tlhegh choHmoHghach "
"(readline) chu'Ha'\n"

#: help.c:87
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr "  -o, --output=FILENAME    ta (qoj |pipe) vaD yu'ghach chavmey ngeH\n"

#: help.c:88
msgid "  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr ""
"  -q, --quiet              tamtaHvIS chu' (QInmey tu'lu'be', yu'ghach "
"mejghach neH)\n"

#: help.c:89
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr "  -s, --single-step        wa' neH qIv Dotlh (Hoch yu'ghach rInmoH)\n"

#: help.c:90
msgid ""
"  -S, --single-line        single-line mode (end of line terminates SQL "
"command)\n"
msgstr ""
"  -S, --single-line        wa' neH tlhegh Dotlh (tlhegh mev SQL ra' mevmoH)\n"

#: help.c:92
msgid ""
"\n"
"Output format options:\n"
msgstr ""
"\n"
"mejghach chenghach wIvmeHmey:\n"

#: help.c:93
