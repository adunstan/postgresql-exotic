+msgid "SELECT rule's target list has too few entries"
+msgstr "la cela listo de la regulo SELECT havas tro malmultajn erojn"
+
+#: rewrite/rewriteDefine.c:621
+#, c-format
+msgid "RETURNING list has too few entries"
+msgstr "la RETURNING-listo havas tro malmultajn erojn"
+
+#: rewrite/rewriteDefine.c:710 rewrite/rewriteDefine.c:836
+#: rewrite/rewriteSupport.c:108
+#, c-format
+msgid "rule \"%s\" for relation \"%s\" does not exist"
+msgstr "la regulo \"%s\" por la rilato \"%s\" ne ekzistas"
+
