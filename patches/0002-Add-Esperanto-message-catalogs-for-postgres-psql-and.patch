+msgstr "neniu Snowball-radikigilo disponebla por lingvo \"%s\" kaj kodigo \"%s\""
+
+#: snowball/dict_snowball.c:253 tsearch/dict_ispell.c:81
+#: tsearch/dict_simple.c:50
