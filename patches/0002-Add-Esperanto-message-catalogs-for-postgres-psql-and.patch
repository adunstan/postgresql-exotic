+#: main/main.c:386
+#, c-format
+msgid ""
+"%s is the PostgreSQL server.\n"
+"\n"
+msgstr ""
+"%s estas la PostgreSQL-servilo.\n"
+"\n"
+
+#: main/main.c:387
+#, c-format
+msgid ""
+"Usage:\n"
+"  %s [OPTION]...\n"
+"\n"
+msgstr ""
+"Uzado:\n"
+"  %s [OPTION]...\n"
+"\n"
+
+#: main/main.c:388
+#, c-format
+msgid "Options:\n"
+msgstr "Opcioj:\n"
+
+#: main/main.c:389
+#, c-format
+msgid "  -B NBUFFERS        number of shared buffers\n"
+msgstr "  -B NBUFFERS        nombro de komunaj bufroj\n"
+
+#: main/main.c:390
+#, c-format
+msgid "  -c NAME=VALUE      set run-time parameter\n"
+msgstr "  -c NAME=VALUE      agordi rultempan parametron\n"
+
+#: main/main.c:391
+#, c-format
+msgid "  -C NAME            print value of run-time parameter, then exit\n"
+msgstr "  -C NAME            presi valoron de rultempa parametro, poste eliri\n"
+
+#: main/main.c:392
+#, c-format
+msgid "  -d 1-5             debugging level\n"
+msgstr "  -d 1-5             sencimiga nivelo\n"
+
+#: main/main.c:393
+#, c-format
+msgid "  -D DATADIR         database directory\n"
+msgstr "  -D DATADIR         datumbaza dosierujo\n"
+
+#: main/main.c:394
+#, c-format
+msgid "  -e                 use European date input format (DMY)\n"
+msgstr "  -e                 uzi Eŭropan enigan formaton de dato (DMY)\n"
+
+#: main/main.c:395
+#, c-format
+msgid "  -F                 turn fsync off\n"
+msgstr "  -F                 malŝalti fsync\n"
+
+#: main/main.c:396
+#, c-format
+msgid "  -h HOSTNAME        host name or IP address to listen on\n"
+msgstr "  -h HOSTNAME        nomo de gastiganto aŭ IP-adreso ĉe kiu aŭskulti\n"
+
+#: main/main.c:397
+#, c-format
+msgid "  -i                 enable TCP/IP connections (deprecated)\n"
+msgstr "  -i                 ebligi konektojn per TCP/IP (evitinda)\n"
+
+#: main/main.c:398
+#, c-format
+msgid "  -k DIRECTORY       Unix-domain socket location\n"
+msgstr "  -k DIRECTORY       loko de Unix-domajna soketo\n"
+
+#: main/main.c:400
+#, c-format
+msgid "  -l                 enable SSL connections\n"
+msgstr "  -l                 ebligi SSL-konektojn\n"
+
+#: main/main.c:402
+#, c-format
+msgid "  -N MAX-CONNECT     maximum number of allowed connections\n"
+msgstr "  -N MAX-CONNECT     maksimuma nombro de permesataj konektoj\n"
+
+#: main/main.c:403
+#, c-format
+msgid "  -p PORT            port number to listen on\n"
+msgstr "  -p PORT            pordnumero ĉe kiu aŭskulti\n"
+
+#: main/main.c:404
+#, c-format
+msgid "  -s                 show statistics after each query\n"
+msgstr "  -s                 montri statistikon post ĉiu demando\n"
+
+#: main/main.c:405
+#, c-format
+msgid "  -S WORK-MEM        set amount of memory for sorts (in kB)\n"
+msgstr "  -S WORK-MEM        agordi kvanton da memoro por ordigoj (en kB)\n"
+
+#: main/main.c:406
+#, c-format
+msgid "  -V, --version      output version information, then exit\n"
+msgstr "  -V, --version      eligi informojn pri versio, poste eliri\n"
+
+#: main/main.c:407
+#, c-format
+msgid "  --NAME=VALUE       set run-time parameter\n"
+msgstr "  --NAME=VALUE       agordi rultempan parametron\n"
+
+#: main/main.c:408
+#, c-format
+msgid "  --describe-config  describe configuration parameters, then exit\n"
+msgstr "  --describe-config  priskribi agordajn parametrojn, poste eliri\n"
+
+#: main/main.c:409
+#, c-format
+msgid "  -?, --help         show this help, then exit\n"
+msgstr "  -?, --help         montri ĉi tiun helpon, poste eliri\n"
+
+#: main/main.c:411
+#, c-format
+msgid ""
+"\n"
+"Developer options:\n"
+msgstr ""
+"\n"
+"Opcioj por programistoj:\n"
+
+#: main/main.c:412
+#, c-format
+msgid "  -f s|i|o|b|t|n|m|h forbid use of some plan types\n"
+msgstr "  -f s|i|o|b|t|n|m|h malpermesi la uzon de iuj tipoj de plano\n"
+
+#: main/main.c:413
+#, c-format
+msgid "  -O                 allow system table structure changes\n"
+msgstr ""
+"  -O                 permesi ŝanĝojn de la strukturo de sistemaj tabeloj\n"
+
+#: main/main.c:414
+#, c-format
+msgid "  -P                 disable system indexes\n"
+msgstr "  -P                 malŝalti sistemajn indeksojn\n"
+
+#: main/main.c:415
+#, c-format
+msgid "  -t pa|pl|ex        show timings after each query\n"
+msgstr "  -t pa|pl|ex        montri tempomezurojn post ĉiu demando\n"
+
+#: main/main.c:416
+#, c-format
+msgid "  -T                 send SIGABRT to all backend processes if one dies\n"
+msgstr ""
+"  -T                 sendi SIGABRT al ĉiuj servilaj procezoj se unu mortas\n"
+
+#: main/main.c:417
+#, c-format
+msgid "  -W NUM             wait NUM seconds to allow attach from a debugger\n"
+msgstr ""
+"  -W NUM             atendi NUM sekundojn por permesi alligon de "
+"sencimigilo\n"
+
+#: main/main.c:419
+#, c-format
+msgid ""
+"\n"
+"Options for single-user mode:\n"
+msgstr ""
+"\n"
+"Opcioj por unu-uzanta reĝimo:\n"
+
+#: main/main.c:420
+#, c-format
+msgid "  --single           selects single-user mode (must be first argument)\n"
+msgstr ""
+"  --single           elektas unu-uzantan reĝimon (devas esti la unua "
+"argumento)\n"
+
+#: main/main.c:421
+#, c-format
+msgid "  DBNAME             database name (defaults to user name)\n"
+msgstr "  DBNAME             nomo de datumbazo (defaŭlte la nomo de la uzanto)\n"
+
+#: main/main.c:422
+#, c-format
+msgid "  -d 0-5             override debugging level\n"
+msgstr "  -d 0-5             superregi la sencimigan nivelon\n"
+
+#: main/main.c:423
+#, c-format
+msgid "  -E                 echo statement before execution\n"
+msgstr "  -E                 eĥi la ordonon antaŭ plenumo\n"
+
+#: main/main.c:424
+#, c-format
+msgid "  -j                 do not use newline as interactive query delimiter\n"
+msgstr ""
+"  -j                 ne uzi novlinion kiel disigilon de interaga demando\n"
+
+#: main/main.c:425 main/main.c:431
+#, c-format
+msgid "  -r FILENAME        send stdout and stderr to given file\n"
+msgstr "  -r FILENAME        sendi stdout kaj stderr al donita dosiero\n"
+
+#: main/main.c:427
+#, c-format
+msgid ""
+"\n"
+"Options for bootstrapping mode:\n"
+msgstr ""
+"\n"
+"Opcioj por praŝarga reĝimo:\n"
+
+#: main/main.c:428
+#, c-format
+msgid ""
+"  --boot             selects bootstrapping mode (must be first argument)\n"
+msgstr ""
+"  --boot             elektas praŝargan reĝimon (devas esti la unua "
+"argumento)\n"
+
+#: main/main.c:429
+#, c-format
+msgid "  --check            selects check mode (must be first argument)\n"
+msgstr ""
+"  --check            elektas kontrolan reĝimon (devas esti la unua "
+"argumento)\n"
+
+#: main/main.c:430
+#, c-format
+msgid ""
+"  DBNAME             database name (mandatory argument in bootstrapping "
+"mode)\n"
+msgstr ""
+"  DBNAME             nomo de datumbazo (deviga argumento en praŝarga "
+"reĝimo)\n"
+
+#: main/main.c:433
+#, c-format
+msgid ""
+"\n"
+"Please read the documentation for the complete list of run-time\n"
+"configuration settings and how to set them on the command line or in\n"
+"the configuration file.\n"
+"\n"
+"Report bugs to <%s>.\n"
+msgstr ""
+"\n"
+"Bonvolu legi la dokumentaron por la plena listo de rultempaj\n"
+"agordoj kaj kiel agordi ilin per la komandlinio aŭ en\n"
+"la agorda dosiero.\n"
+"\n"
+"Raportu cimojn al <%s>.\n"
+
+#: main/main.c:437
+#, c-format
+msgid "%s home page: <%s>\n"
+msgstr "%s-hejmpaĝo: <%s>\n"
+
+#: main/main.c:448
+#, c-format
+msgid ""
+"\"root\" execution of the PostgreSQL server is not permitted.\n"
+"The server must be started under an unprivileged user ID to prevent\n"
+"possible system security compromise.  See the documentation for\n"
+"more information on how to properly start the server.\n"
+msgstr ""
+"\"root\"-rulado de la PostgreSQL-servilo ne estas permesata.\n"
+"La servilo devas esti startigita sub senprivilegia uzanto-ID por eviti\n"
+"eblan endanĝerigon de la sistema sekureco.  Vidu la dokumentaron por\n"
+"pli da informo pri kiel ĝuste startigi la servilon.\n"
+
+#: main/main.c:465
+#, c-format
+msgid "%s: real and effective user IDs must match\n"
+msgstr "%s: realaj kaj efektivaj uzanto-ID-oj devas kongrui\n"
+
+#: main/main.c:472
+#, c-format
+msgid ""
+"Execution of PostgreSQL by a user with administrative permissions is not\n"
+"permitted.\n"
+"The server must be started under an unprivileged user ID to prevent\n"
+"possible system security compromises.  See the documentation for\n"
+"more information on how to properly start the server.\n"
+msgstr ""
+"Ruligo de PostgreSQL de uzanto kun\n"
+"administraj permesoj ne estas permesata.\n"
+"La servilo devas esti startigita sub senprivilegia uzanto-ID por eviti\n"
+"eblajn endanĝerigojn de la sistema sekureco.  Vidu la dokumentaron por\n"
+"pli da informo pri kiel ĝuste startigi la servilon.\n"
+
