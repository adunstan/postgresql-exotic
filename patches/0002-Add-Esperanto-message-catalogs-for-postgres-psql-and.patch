+msgid "multiple StopWords parameters"
+msgstr "multoblaj parametroj StopWords"
+
+#: snowball/dict_snowball.c:262
+#, c-format
+msgid "multiple Language parameters"
+msgstr "multoblaj parametroj Language"
+
+#: snowball/dict_snowball.c:269
+#, c-format
+msgid "unrecognized Snowball parameter: \"%s\""
+msgstr "nerekonita Snowball-parametro: \"%s\""
+
+#: snowball/dict_snowball.c:277
+#, c-format
+msgid "missing Language parameter"
+msgstr "mankas parametro Language"
+
